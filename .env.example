# ============================================================
# Skill Infinity Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ============================================================
# Database
# ============================================================
MYSQL_ROOT_PASSWORD=root123
MYSQL_PORT=3306

# ============================================================
# RabbitMQ
# ============================================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ============================================================
# Config Server
# ============================================================
CONFIG_SERVER_PORT=8888
CONFIG_REPO_URI=
CONFIG_REPO_DEFAULT_BRANCH=main

# ============================================================
# Discovery Server (Eureka)
# ============================================================
DISCOVERY_SERVER_PORT=8761
EUREKA_DEFAULT_ZONE=http://discovery-server:8761/eureka/
EUREKA_HOSTNAME=discovery-server

# ============================================================
# API Gateway
# ============================================================
API_GATEWAY_PORT=8080

# ============================================================
# JWT
# ============================================================
JWT_SECRET=4a6f686e446f6553656372657456657279566572795365637265744b6579466f724a57545369676e696e67416e64456e6372797074696f6e
# Access tokens: 8h (was 15 min — short-lived tokens caused constant
# 401 → refresh → retry churn and "session expired" popups).
JWT_ACCESS_EXPIRY=28800000
JWT_REFRESH_EXPIRY=604800000

# ============================================================
# Razorpay (test mode) — required for credit purchases
# ============================================================
# Get TEST keys from https://dashboard.razorpay.com/app/keys (no cost).
# Leave blank to run the rest of the platform; buying credits will return
# a clear "Razorpay is not configured" error instead of a 403.
# After adding keys, recreate the payment-service: docker compose up -d --build payment-service
RAZORPAY_KEY_ID=rzp_test_TPtgVZcQ24WMoV
RAZORPAY_KEY_SECRET=vwPXu7xqkhsPC1qWCQvajZ5Q
RAZORPAY_WEBHOOK_SECRET=

# ============================================================
# Sessions
# ============================================================
# Free/community sessions a learner can join per calendar month.
COMMUNITY_ALLOWANCE_PER_MONTH=5
# Join window: participants can join a session from this many minutes
# before its start time until its end time.
JOIN_WINDOW_MINUTES=10
# REAL Discord meeting invite (full URL) — e.g. a permanent invite to your
# Skill Infinity Discord server: https://discord.gg/<REAL_INVITE_CODE>.
# Create it in Discord (Server Settings → Invites → Edit invite link → never
# expire, no usage limit) and paste the full URL here. Every session then
# returns this SAME invite to both mentor and learner. Leave blank to store
# no meeting link (the UI shows "Meeting link is not available yet.").
# The app NEVER fabricates a discord.gg code.
DISCORD_MEETING_URL=https://discord.gg/48T9GT3XgU
# Legacy alias: a REAL invite code (the part after https://discord.gg/).
# Used only when DISCORD_MEETING_URL is blank.
DISCORD_INVITE_CODE=

# ============================================================
# Frontend
# ============================================================
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080/api/v1
