# ============================================================
# Skill Infinity — Production Environment
# ============================================================

VITE_APP_ENV=production
VITE_APP_NAME=Skill Infinity
VITE_APP_VERSION=0.1.0

# Relative path — the API Gateway is proxied through nginx
VITE_API_BASE_URL=/api/v1

# WebSocket / Socket.IO endpoint (proxied through nginx)
VITE_WS_URL=wss://app.skillinfinity.com
VITE_SOCKET_URL=https://app.skillinfinity.com

# Request timeout in milliseconds
VITE_API_TIMEOUT=30000
