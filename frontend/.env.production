# Production build configuration (served by nginx on :80).
#
# IMPORTANT: VITE_API_BASE_URL must stay a relative path (/api/v1) in the
# dockerized setup. nginx.conf proxies /api/ -> api-gateway:8080, so requests
# stay same-origin and never trigger CORS. An absolute URL like
# http://localhost:8080/api/v1 makes the browser call the gateway cross-origin
# and every register/login fails with a CORS 403 (the gateway's allowed-origin
# list would have to include the browser origin).
VITE_APP_ENV=production
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000

